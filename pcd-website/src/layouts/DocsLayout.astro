---
import type { ImageMetadata, MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import DocsTableOfContents from '../components/DocsTableOfContents.astro';
import DocsPageActions from '../components/DocsPageActions.astro';
import BackButton from '../components/BackButton.astro';
import { getKitNav } from '../config/organizer-kit-nav';
import '../styles/base.css';
import '../styles/docs.css';

interface Props {
  title: string;
  description: string;
  /** Rendered above the h1 as the section label. */
  eyebrow?: string;
  /** Parent navigation shown in place of the eyebrow. */
  backLink?: { href: string; label: string };
  /** Page heading. Falls back to `title` when omitted. */
  heading?: string;
  /** Optional logo displayed within the h1, using the heading as alt text. */
  headingLogo?: ImageMetadata;
  headings?: MarkdownHeading[];
  /** Suppresses the "On this page" table of contents. */
  hideToc?: boolean;
  /** Page content, ready to copy as Markdown. */
  markdown?: string;
  /** GitHub URL for editing this page's source. */
  editHref?: string;
}

const { title, description, eyebrow, backLink, heading, headingLogo, headings = [], hideToc = false, markdown, editHref } = Astro.props;

const nav = await getKitNav();
const permalink = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<BaseLayout
  title={`${title} — Processing Community Day`}
  description={description}
  bodyClass="site-body docs-body"
>
  <a href="#main" class="skip-link">Skip to main content</a>
  <Header />
  <div class="docs-shell">
    <aside class="docs-shell__nav">
      <button class="docs-nav-toggle btn-reset" type="button" aria-expanded="false" hidden>
        Organizer Kit contents
      </button>
      <DocsSidebar nav={nav} currentPath={Astro.url.pathname} />
    </aside>

    <main id="main" tabindex="-1" class="docs-shell__main">
      <article class="docs-prose">
        {backLink
          ? <BackButton href={backLink.href} label={backLink.label} />
          : eyebrow && <p class="prose__eyebrow">{eyebrow}</p>}
        <div class:list={['docs-title-row', { 'docs-title-row--logo': headingLogo }]}>
          <h1>{headingLogo
            ? <Image class="docs-heading-logo" src={headingLogo} alt={heading ?? title} />
            : heading ?? title}</h1>
          {markdown && editHref && (
            <DocsPageActions markdown={markdown} permalink={permalink} editHref={editHref} />
          )}
        </div>
        {!hideToc && <DocsTableOfContents headings={headings} />}
        <slot />
      </article>
    </main>
  </div>
  <Footer />
</BaseLayout>

<style>
  .docs-title-row--logo {
    row-gap: var(--sp-6);
    margin-bottom: var(--sp-6);
  }

  .docs-heading-logo {
    display: block;
    width: auto;
    height: 48px;
    max-width: 100%;
    object-fit: contain;
    object-position: left;
    margin: 0;
  }
</style>

<script is:inline>
  (() => {
    const toggle = document.querySelector('.docs-nav-toggle');
    const nav = document.getElementById('docs-nav');
    if (!toggle || !nav) return;
    toggle.hidden = false;
    document.documentElement.classList.add('docs-nav-collapsible');
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
    });
  })();
</script>

<script is:inline>
  (() => {
    document.querySelectorAll('.docs-heading-anchor').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const url = new URL(link.getAttribute('href'), window.location.href).href;
        history.replaceState(null, '', link.getAttribute('href'));
        navigator.clipboard?.writeText(url);
        link.classList.add('docs-heading-anchor--copied');
        setTimeout(() => link.classList.remove('docs-heading-anchor--copied'), 1200);
      });
    });
  })();
</script>
